<Window x:Class="Makelazy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Makelazy.App"
        Title="Makelazy — Makefile Runner (Native)" Height="760" Width="1180"
        MinHeight="520" MinWidth="860"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        Background="#F1F5F9">
    <Window.Resources>
        <local:StringJoinConverter x:Key="Join"/>
        <local:NonEmptyToVisibilityConverter x:Key="NonEmptyVis"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Nút bo tròn -->
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource RoundBtn}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#34D399" Offset="0"/>
                        <GradientStop Color="#06B6D4" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22D3EE" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1E293B">
                            Makelazy <Run Foreground="#0891B2">· Makefile Runner</Run>
                        </TextBlock>
                        <TextBlock x:Name="FilePathText" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="520"
                                   Text="Chưa mở Makefile — bấm “Mở Makefile” hoặc kéo-thả file vào cửa sổ"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Background="#F8FAFC" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="#475569"><Run x:Name="TargetCountText" Text="0"/> targets</TextBlock>
                    </Border>
                    <Button x:Name="PinButton" Style="{StaticResource RoundBtn}" Background="White" BorderBrush="#E2E8F0" Foreground="#475569"
                            FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" Click="PinButton_Click" Content="📌 Ghim Open-With"/>
                    <Button Style="{StaticResource RoundBtn}" Background="#0891B2" BorderBrush="#0891B2" Foreground="White"
                            FontSize="12" FontWeight="SemiBold" Click="OpenButton_Click" Content="📂 Mở Makefile"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#94A3B8"
                           Text="Terminal ẩn (CreateNoWindow) · stream trực tiếp · gõ stdin ở ô dưới mỗi tab"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="SessionInfoText" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="480"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: targets -->
            <DockPanel Grid.Column="0" Background="White">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="12,12,12,8" Padding="8,6"
                         BorderBrush="#E2E8F0" FontSize="12" Foreground="#1E293B"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Resources>
                        <VisualBrush x:Key="Hint" AlignmentX="Left" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍 Tìm target / lệnh…" Foreground="#94A3B8" FontSize="12" Margin="4,0"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource Hint}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ListBox x:Name="TargetList" BorderThickness="0" Background="White" Padding="8,0,8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Background="White" Padding="10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource PlayBtn}" Content="▶"
                                            Tag="{Binding Name}" Click="RunButton_Click" ToolTip="Chạy target này"
                                            VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#0E7490" Text="{Binding Name}"/>
                                            <Border Background="#EDE9FE" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsPhony, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="PHONY" FontSize="9" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                            </Border>
                                            <TextBlock FontSize="10" Foreground="#94A3B8" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Run Text=":"/><Run Text="{Binding Line}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Description, Converter={StaticResource NonEmptyVis}}"/>
                                        <TextBlock FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Dependencies, Converter={StaticResource NonEmptyVis}}">
                                            <Run Text="deps: "/><Run Text="{Binding Dependencies, Converter={StaticResource Join}, ConverterParameter=' '}"/>
                                        </TextBlock>
                                        <Expander Header="recipe" FontSize="11" Foreground="#64748B" Margin="0,2,0,0">
                                            <ItemsControl ItemsSource="{Binding Commands}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,0,3">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#334155" TextWrapping="Wrap">
                                                                <Run Text="$ "/><Run Text="{Binding Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- RIGHT: tabs terminal -->
            <Grid Grid.Column="2" Background="#F1F5F9">
                <TabControl x:Name="SessionTabs" Background="#F1F5F9" BorderThickness="0" Padding="0"
                            SelectionChanged="SessionTabs_SelectionChanged"/>
                <Border x:Name="EmptyHint" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Background="White"
                        Margin="12" Padding="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🖥️" FontSize="44" HorizontalAlignment="Center"/>
                        <TextBlock Text="Output của process sẽ hiện ở đây." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Mỗi lần bấm ▶ là 1 tab terminal riêng, stream trực tiếp." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
